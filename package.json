  "author": {
    "name": "ShipStatic",
    "email": "hello@shipstatic.com",
    "url": "https://shipstatic.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shipstatic/opencode.git"
  },
  "homepage": "https://shipstatic.com",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "files": [
    "src",
    "skills"
