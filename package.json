    "@biomejs/biome": "2.5.5",
    "@opencode/plugin": "2.2.7",
    "@types/node": "24.13.3",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
